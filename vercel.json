{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": { "api/kk.js": { "maxDuration": 60 } },
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "Permissions-Policy", "value": "camera=(self)" },
      { "key": "Cache-Control", "value": "no-cache" },
      { "key": "X-Robots-Tag", "value": "noindex, nofollow" } ] }
  ]
}
